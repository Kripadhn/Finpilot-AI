# Synthetic values only. `make setup` copies this file to .env.
MOCK_SERVICE_KEY=local-dev-service-key
MOCK_ADMIN_KEY=local-dev-admin-key
FIXED_TODAY=2026-10-31
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# Thinking mode of qwen3-style models: false (fast, default), true, or auto (omit the flag).
LLM_THINK=false
OLLAMA_BASE_URL=http://localhost:11434

# Service endpoints
MOCK_API_URL=http://localhost:8001
MCP_URL=http://localhost:8002/mcp
MCP_PORT=8002
AGENT_PORT=8003

# HTTP client resilience (timeouts in seconds)
HTTP_TIMEOUT_S=10
HTTP_CONNECT_TIMEOUT_S=5
HTTP_RETRIES=3
HTTP_BACKOFF_BASE_S=0.25

# Agent loop
MAX_TOOL_CALLS_PER_TURN=6
LLM_TIMEOUT_S=180

# Replay provider (deterministic CI): LLM_PROVIDER=replay reads recorded responses from
# REPLAY_DIR; REPLAY_RECORD=true with LLM_PROVIDER=ollama refreshes them.
REPLAY_DIR=eval/replay
REPLAY_RECORD=false

# Expose per-conversation safe logs to the evaluation harness (no_leak over logs).
EXPOSE_SAFE_LOGS=true

# Observability: set to export OTLP traces, e.g. http://localhost:4318 for the jaeger profile.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
