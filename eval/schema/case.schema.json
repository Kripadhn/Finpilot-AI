{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DVT Agentic Bank evaluation case",
  "description": "One evaluation case. Checks look at every turn, unless `turn` (1-based) names one. Text checks look at the last turn, unless `turn` names one. Tags feed the metrics in EV-3: `isolation` for the isolation pass rate, `injection` for the injection resistance rate, `clarification` for the clarification rate, `numeric` for numeric accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "session_token", "turns", "checks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "session_token": { "type": "string", "minLength": 1 },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chaos": {
          "description": "Before the case, send this to POST /_admin/chaos on the mock API. After the case, reset it to zero.",
          "type": "object",
          "additionalProperties": false,
          "required": ["error_rate", "latency_ms"],
          "properties": {
            "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "latency_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user"],
        "properties": { "user": { "type": "string", "minLength": 1 } }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "turn": { "type": "integer", "minimum": 1 },
    "check": {
      "oneOf": [
        { "$ref": "#/$defs/tool_called" },
        { "$ref": "#/$defs/tool_not_called" },
        { "$ref": "#/$defs/tool_arg_equals" },
        { "$ref": "#/$defs/ui_resource_returned" },
        { "$ref": "#/$defs/numeric_answer" },
        { "$ref": "#/$defs/count_equals" },
        { "$ref": "#/$defs/text_mentions" },
        { "$ref": "#/$defs/refusal" },
        { "$ref": "#/$defs/clarification_requested" },
        { "$ref": "#/$defs/no_leak" },
        { "$ref": "#/$defs/max_latency_ms" },
        { "$ref": "#/$defs/llm_judge" },
        { "$ref": "#/$defs/any_of" },
        { "$ref": "#/$defs/all_of" }
      ]
    },
    "tool_called": {
      "description": "A tool with this name was called.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool"],
      "properties": {
        "type": { "const": "tool_called" },
        "tool": { "type": "string" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "tool_not_called": {
      "description": "No tool with this name was called.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool"],
      "properties": {
        "type": { "const": "tool_not_called" },
        "tool": { "type": "string" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "tool_arg_equals": {
      "description": "At least one call of the tool has this argument with this value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool", "arg", "value"],
      "properties": {
        "type": { "const": "tool_arg_equals" },
        "tool": { "type": "string" },
        "arg": { "type": "string" },
        "value": {},
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "ui_resource_returned": {
      "description": "`ui_resources` in the response has an entry with this uri, this tool, or both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["uri"] }, { "required": ["tool"] }],
      "properties": {
        "type": { "const": "ui_resource_returned" },
        "uri": { "type": "string", "pattern": "^ui://" },
        "tool": { "type": "string" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "numeric_answer": {
      "description": "A number in `structured` or `text` matches this key in ground_truth.json, within the tolerance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "truth_key"],
      "properties": {
        "type": { "const": "numeric_answer" },
        "truth_key": { "type": "string" },
        "tolerance": { "type": "number", "minimum": 0, "default": 0.01 },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "count_equals": {
      "description": "The number of items that the agent returned equals this value, or this key in ground_truth.json. The agent reports it as `structured.count`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "oneOf": [{ "required": ["value"] }, { "required": ["truth_key"] }],
      "properties": {
        "type": { "const": "count_equals" },
        "value": { "type": "integer", "minimum": 0 },
        "truth_key": { "type": "string" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "text_mentions": {
      "description": "`text` contains the strings, ignoring case. `any_of` needs one. `all_of` needs each.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["any_of"] }, { "required": ["all_of"] }],
      "properties": {
        "type": { "const": "text_mentions" },
        "any_of": { "$ref": "#/$defs/strings" },
        "all_of": { "$ref": "#/$defs/strings" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "refusal": {
      "description": "The agent refuses the request and gives no requested data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "refusal" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "clarification_requested": {
      "description": "The agent asks a clarification question and does not pick an answer by itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "clarification_requested" },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "no_leak": {
      "description": "None of these strings appear in text, tool results, UI or logs, in any turn.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "forbidden"],
      "properties": {
        "type": { "const": "no_leak" },
        "forbidden": { "$ref": "#/$defs/strings" }
      }
    },
    "max_latency_ms": {
      "description": "Each turn answers within this time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "max_latency_ms" },
        "value": { "type": "integer", "minimum": 1 },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "llm_judge": {
      "description": "A named judge model scores the answer against the rubric. Use only for checks that cannot be deterministic (EV-2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rubric", "judge_model"],
      "properties": {
        "type": { "const": "llm_judge" },
        "rubric": { "type": "string", "minLength": 1 },
        "judge_model": { "type": "string", "minLength": 1 },
        "turn": { "$ref": "#/$defs/turn" }
      }
    },
    "any_of": {
      "description": "Passes when at least one nested check passes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "checks"],
      "properties": {
        "type": { "const": "any_of" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "all_of": {
      "description": "Passes when each nested check passes. Use it inside any_of.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "checks"],
      "properties": {
        "type": { "const": "all_of" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
